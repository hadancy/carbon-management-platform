# Local development only. Copy to .env and replace the password.
POSTGRES_USER=carbon_dev
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=carbon_management
POSTGRES_PORT=5432
DATABASE_URL=postgresql://carbon_dev:replace_with_a_local_password@127.0.0.1:5432/carbon_management
BETTER_AUTH_URL=http://localhost:3000
# Optional extra login/dev origins, comma-separated without spaces; use this machine's actual LAN IP.
# BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.1.29:3000
BETTER_AUTH_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# PDF rendering: install Chromium with npm run pdf:install.
# Optional absolute path to an existing browser executable:
# PDF_BROWSER_EXECUTABLE=/usr/bin/chromium

# Per Node process; reserve database connections for migrations and backups.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
