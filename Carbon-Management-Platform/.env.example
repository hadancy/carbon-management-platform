# Local development only. Copy to .env and replace the password.
POSTGRES_USER=carbon_dev
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=carbon_management
POSTGRES_PORT=5432
DATABASE_URL=postgresql://carbon_dev:replace_with_a_local_password@127.0.0.1:5432/carbon_management
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace_with_a_random_secret_of_at_least_32_characters
