{
  "name": "carbon-management-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "bootstrap:admin": "node --import tsx scripts/bootstrap-admin.ts",
    "test:integration": "node scripts/stage3-smoke.mjs",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@ant-design/nextjs-registry": "1.3.0",
    "@better-auth/prisma-adapter": "1.7.5",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "antd": "6.6.5",
    "auth": "1.7.5",
    "better-auth": "1.7.5",
    "dotenv": "17.2.3",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "24.10.15",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "^8.5.28",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "tailwindcss": "^4.1.18",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
