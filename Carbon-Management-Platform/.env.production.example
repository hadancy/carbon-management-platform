# Set these through the deployment secret manager. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/carbon_management?sslmode=require
BETTER_AUTH_URL=https://carbon.example.edu
BETTER_AUTH_SECRET=replace_with_secret_manager_value_at_least_32_characters

# PDF rendering: install Chromium with npm run pdf:install.
# Optional absolute path to an existing browser executable:
# PDF_BROWSER_EXECUTABLE=/usr/bin/chromium

# Per Node process; reserve database connections for migrations and backups.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
